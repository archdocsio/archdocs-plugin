{
  "id": "auto-close-out-prepared",
  "org": "full",
  "setup": "with-done-handoff",
  "prompt": "Pick up {{designDocNumber}}.",
  "expect": {
    "mustSucceed": [
      "get_journal_handoff",
      "write_design_doc_variation",
      "mark_variation_ready"
    ],
    "argMatches": [
      {
        "tool": "write_design_doc_variation",
        "path": "variation",
        "pattern": "^evidence$",
        "ok": true
      },
      {
        "tool": "write_design_doc_variation",
        "path": "content",
        "pattern": "[Bb]atch",
        "ok": true
      },
      {
        "tool": "mark_variation_ready",
        "path": "variation",
        "pattern": "^evidence$",
        "ok": true
      }
    ],
    "mustNotCall": [
      "mark_design_doc_shipped",
      "create_design_doc"
    ],
    "finalTextMatches": "live|ship",
    "state": {
      "variationState": {
        "evidence": "READY"
      }
    }
  }
}
