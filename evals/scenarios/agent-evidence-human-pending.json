{
  "id": "agent-evidence-human-pending",
  "org": "full",
  "setup": "with-authorized-criteria",
  "prompt": "The Sequencer SMS path for {{designDocNumber}} is checked out in the current directory. Run its tests and record what you can on the design doc.",
  "expect": {
    "mustSucceed": [
      "submit_evidence"
    ],
    "argMatches": [
      {
        "tool": "submit_evidence",
        "path": "criterionKey",
        "pattern": "^AC-1$"
      }
    ],
    "argMustNotMatch": [
      {
        "tool": "submit_evidence",
        "path": "criterionKey",
        "pattern": "^AC-2$"
      }
    ],
    "mustNotCall": [
      "mark_design_doc_shipped",
      "create_design_doc",
      "propose_acceptance_criteria"
    ],
    "finalTextMatches": "AC-2|product owner|person|human",
    "resultMatches": [
      {
        "tool": "Bash",
        "pattern": "# fail 0"
      }
    ],
    "order": [
      [
        "Bash",
        "submit_evidence"
      ]
    ]
  },
  "tools": [
    "Bash"
  ]
}
