{
  "id": "review-feedback-addressed",
  "org": "full",
  "setup": "with-review-thread",
  "prompt": "A reviewer left comments on {{designDocNumber}}'s spec. Handle them.",
  "expect": {
    "mustSucceed": [
      "reply_to_comment_thread",
      "add_design_doc_question"
    ],
    "argMatches": [
      {
        "tool": "add_design_doc_question",
        "path": "text",
        "pattern": "[Rr]eject|[Ff]ail|[Ii]nvalid"
      },
      {
        "tool": "reply_to_comment_thread",
        "path": "content",
        "pattern": "Q[0-9]|question|[Rr]eject|[Ff]ail"
      }
    ],
    "mustNotCall": [
      "mark_design_doc_shipped",
      "create_design_doc",
      "resolve_comment_thread"
    ]
  }
}
