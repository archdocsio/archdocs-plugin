{
  "id": "lean-org-close-out",
  "org": "lean",
  "setup": "design-doc-with-spec-and-plan",
  "prompt": "PR https://github.com/example/cadence/pull/42 merged, {{designDocNumber}} is done. It shipped as planned, except that delivery events are batched every 5 seconds instead of streamed, because the stream client dropped events under load. The delivery-receipt webhook wasn't built; it's deferred to next quarter.",
  "expect": {
    "mustCall": [
      "write_design_doc_variation",
      "mark_variation_ready"
    ],
    "mustNotCall": [
      "link_pull_request",
      "set_planned_changes",
      "mark_design_doc_shipped"
    ],
    "argMatches": [
      {
        "tool": "write_design_doc_variation",
        "path": "variation",
        "pattern": "^evidence$"
      },
      {
        "tool": "write_design_doc_variation",
        "path": "content",
        "pattern": "[Bb]atch"
      },
      {
        "tool": "mark_variation_ready",
        "path": "variation",
        "pattern": "^evidence$"
      }
    ],
    "finalTextMatches": "ship"
  }
}
