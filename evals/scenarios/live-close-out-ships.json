{
  "id": "live-close-out-ships",
  "org": "lean",
  "setup": "design-doc-with-spec-and-plan",
  "prompt": "PR https://github.com/example/cadence/pull/42 merged and it's live in prod. It shipped as planned, except that delivery events are batched every 5 seconds instead of streamed, because the stream client dropped events under load. The delivery-receipt webhook wasn't built; it's deferred to next quarter. Close out {{designDocNumber}}.",
  "expect": {
    "mustSucceed": [
      "write_design_doc_variation",
      "mark_design_doc_shipped"
    ],
    "mustNotCall": [
      "mark_variation_ready",
      "request_design_doc_review"
    ],
    "order": [
      {
        "before": "write_design_doc_variation",
        "after": "mark_design_doc_shipped",
        "ok": true
      }
    ],
    "argMatches": [
      {
        "tool": "write_design_doc_variation",
        "path": "variation",
        "pattern": "^evidence$",
        "ok": true
      },
      {
        "tool": "write_design_doc_variation",
        "path": "content",
        "pattern": "[Bb]atch",
        "ok": true
      }
    ],
    "state": {
      "designDocStatus": "SHIPPED"
    }
  }
}
